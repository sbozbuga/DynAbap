   <?formServer defaultPDFRenderFormat acrobat9.0static?>
   <subform layout="tb" locale="en_US" name="data" restoreState="auto">
      <pageSet>
         <occur max="1"/>
         <pageArea name="PAGE1">
            <medium long="297mm" short="210mm" stock="a4"/>
            <!-- Margins and content area -->
            <contentArea h="240mm" name="contentArea-PAGE1" w="180mm" x="15mm" y="30mm"/>
            <!-- Static Header -->
            <draw h="15mm" name="HeaderLabel" w="180mm" x="15mm" y="10mm">
               <value>
                  <exData contentType="text/html">
                     <body xmlns="http://www.w3.org/1999/xhtml">
                           <p style="font-family:'Arial';font-size:16pt;font-weight:bold;color:#1A365D;border-bottom:1px solid #1A365D">
                              SIMPLE ADOBE FORM DEMO2
                           </p>
                        </body>
                  </exData>
               </value>
            </draw>
            <!-- Static Footer with Page Numbers -->
            <draw h="10mm" name="FooterLabel" w="180mm" x="15mm" y="275mm">
               <value>
                  <exData contentType="text/html">
                     <body xmlns="http://www.w3.org/1999/xhtml">
                           <p style="font-family:'Arial';font-size:9pt;text-align:right;color:#718096">
                              Page {SFSY-PAGE} of {GF_FORMPAGES}
                           </p>
                        </body>
                  </exData>
               </value>
            </draw>
            <?templateDesigner expand 1?></pageArea>
         <?templateDesigner expand 0?></pageSet>
      <!-- Flowable Main Content Subform -->
      <subform layout="tb" name="Main" w="180mm">
         <!-- Dynamic Form Title bound to IV_TITLE -->
         <field access="readOnly" h="12mm" name="IV_TITLE" w="180mm">
            <ui>
               <textEdit>
                  <border>
                     <edge presence="none"/>
                  </border>
               </textEdit>
            </ui>
            <font size="14pt" typeface="Arial" weight="bold"/>
            <para hAlign="center" vAlign="middle"/>
            <bind match="dataRef" ref="$.IV_TITLE"/>
            <keep intact="contentArea"/>
         </field>
         <!-- Separator Line -->
         <draw h="0in" name="Line1" w="180mm">
            <value>
               <line slope="/">
                  <edge color="#2B6CB0" thickness="0.5mm"/>
               </line>
            </value>
         </draw>
         <!-- Customer Details Block -->
         <subform layout="lr-tb" name="CustomerBlock" w="179.664mm">
            <margin bottomInset="5mm" topInset="5mm"/>
            <!-- Customer Name field -->
            <field h="10.015mm" name="IV_CUSTOMER" w="85mm">
               <ui>
                  <textEdit>
                     <border presence="hidden"/>
                  </textEdit>
               </ui>
               <font typeface="Arial"/>
               <caption reserve="30mm">
                  <font typeface="Arial" weight="bold"/>
                  <value>
                     <text xliff:rid="0FE9DD17-73E4-4A2C-92FF-1807A63E092B">Customer Name:</text>
                  </value>
               </caption>
               <bind match="dataRef" ref="$.IV_CUSTOMER"/>
            </field>
            <!-- Document Date field -->
            <keep intact="contentArea"/>
            <field h="10mm" name="IV_DATE" w="85mm">
               <ui>
                  <textEdit>
                     <border presence="hidden"/>
                  </textEdit>
               </ui>
               <font typeface="Arial"/>
               <caption reserve="30mm">
                  <font typeface="Arial" weight="bold"/>
                  <value>
                     <text xliff:rid="7E7E415C-0129-4D84-B852-3E0A2A1EEA3D">Document Date:</text>
                  </value>
               </caption>
               <bind match="dataRef" ref="$.IV_DATE"/>
            </field>
            <?templateDesigner expand 1?></subform>
         <!-- Descriptive Text Box -->
         <draw h="30mm" name="DescriptionBox" w="180mm">
            <value>
               <exData contentType="text/html">
                  <body xmlns="http://www.w3.org/1999/xhtml">
                        <p style="font-family:'Arial';font-size:10pt;line-height:14pt">
                           This is a dynamic PDF form generated using SAP Interactive Forms by Adobe.
                           The layout is styled using standard XML Forms Architecture (XFA) specifications.
                           Data from the calling ABAP program (such as title, customer name, and date)
                           is bound directly to the form fields above.
                        </p>
                     </body>
               </exData>
            </value>
         </draw>
         <?templateDesigner expand 1?></subform>
