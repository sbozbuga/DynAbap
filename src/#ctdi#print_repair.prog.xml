     </DOKIL>
     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>/CTDI/PRINT_REPAIR</TDNAME>
      <TDID>RE</TDID>
      <TDSPRAS>D</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00001</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;PURPOSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Das Programm /CTDI/PRINT_REPAIR dient als dynamischer Einstiegspunkt</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> und Routing-Manager für Reparaturberichte. Es basiert auf der</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> Logik des Reports /CELLAG/ALCAREP02, erweitert diesen um flexible</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> Routing-Optionen und soll diesen nach erfolgreichem Testbetrieb</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> vollständig ersetzen.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>HAUPTMERKMALE</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Dynamische Ausgabebestimmung über die Customizing-Tabelle</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> /CTDI/REP_FORMS.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Suchfolgen-Ermittlung (Vertrag, SKZ, AKZ) zur Zuordnung des passenden</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> Drucktreibers.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Zentralisiertes Protokollieren über das standardisierte Anwendungs-Log</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> /CTDI/CL_PRINT_DRIVER_LOG.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>ERWEITERUNG DER DATENLOGIK</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Um die Datenbeschaffung oder -aufbereitung für einen Kunden/ein Projekt</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> zu erweitern:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>1. Erstellen Sie eine Unterklasse von /CTDI/CL_PRINT_DRIVER_BASE.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>2. Überschreiben und implementieren Sie die geschützten Action-Hook-</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> Methoden:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>- unpack_io_data: Parameter aus dem Ausführungskontext entpacken.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>- fetch_data_from_db: Relevante Daten aus der Datenbank selektieren.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>- map_and_register_data: Daten mappen und Formularparameter</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>  registrieren.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>3. Registrieren Sie die Formularparameter im Hook map_and_register_data</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> mittels der Methode register_custom_parameter.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Geben Sie hierbei den expliziten Parametertyp an (z.B.</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> abap_func_exporting, abap_func_tables), um langsame Datenbank-Lookups</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> zur Laufzeit zu vermeiden.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>ERWEITERUNG DER PROZESSLOGIK</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Um die Ablauf- oder Routing-Logik anzupassen:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>1. Pflegen Sie die Einträge in der Tabelle /CTDI/REP_FORMS über</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> Transaktion SM30.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>2. Weisen Sie dem Layout (Smart Form oder Adobe Form) die entsprechende</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> Drucktreiber-Klasse zu.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>3. Nutzen Sie den Klassen-Skelettgenerator in der Engine-Klasse</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> /CTDI/CL_PRINT_CUST_ENGINE für die automatische Anlage von Klassen-</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> Stubs.</TDLINE>
      </TLINE>
     </LINES>
    </item>
    <item>
     <DOKIL>
      <ID>RE</ID>
      <OBJECT>/CTDI/PRINT_REPAIR</OBJECT>
      <LANGU>E</LANGU>
      <TYP>E</TYP>
      <VERSION>0001</VERSION>
      <MASTERLANG>X</MASTERLANG>
      <TXTLINES>00035</TXTLINES>
      <DOKSTATE>A</DOKSTATE>
     </DOKIL>
     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>/CTDI/PRINT_REPAIR</TDNAME>
      <TDID>RE</TDID>
      <TDSPRAS>E</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00001</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;PURPOSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>The /CTDI/PRINT_REPAIR program is the dynamic routing and execution</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> orchestrator for Repair Printouts. It is built upon the logic of</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> the legacy /CELLAG/ALCAREP02 report, extending it with flexible</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> routing capabilities. Once the testing phase is successfully</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> completed, this framework is intended to replace /CELLAG/ALCAREP02</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> entirely.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>FEATURES</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Dynamic output determination based on customizing table /CTDI/REP_FORMS.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Fallback access sequences matching VB/Contract, SKZ, and AKZ to</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> determine print drivers.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Structured logging using the standard application log wrapper</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> /CTDI/CL_PRINT_DRIVER_LOG.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>HOW TO EXTEND DATA LOGIC</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>To extend the data retrieval or formatting logic for a specific</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> customer or project:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>1. Create a subclass inheriting from base class</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> /CTDI/CL_PRINT_DRIVER_BASE.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>2. Redefine and implement the protected action hook methods:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>- unpack_io_data: Extract input/output parameters from execution</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>  context.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>- fetch_data_from_db: Select necessary data from database tables.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>- map_and_register_data: Map internal data and register custom</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>  parameters.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>3. Register custom form parameters in the hook map_and_register_data</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>   using method register_custom_parameter.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Ensure to pass the explicit parameter kind (e.g.,</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> abap_func_exporting, abap_func_tables) to avoid runtime DB lookups.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>HOW TO EXTEND PROCESS LOGIC</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>To change or add routing logic:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>1. Maintain configuration entries in customizing table /CTDI/REP_FORMS</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>   via transaction SM30.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>2. Define the form layout name (Smart Form or Adobe Form) and map it</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>   to your new print driver class.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>3. Use the class skeleton generator in customizing engine class</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> /CTDI/CL_PRINT_CUST_ENGINE to auto-generate class stubs in DEV.</TDLINE>
      </TLINE>
     </LINES>
    </item>
   </LONGTEXTS>
