      <LINES>
       <item>
        <TDFORMAT>U1</TDFORMAT>
        <TDLINE>&amp;FUNCTIONALITY&amp;</TDLINE>
       </item>
       <item>
        <TDFORMAT>AS</TDFORMAT>
        <TDLINE>Die Klasse /CTDI/CL_PRINT_CUST_ENGINE dient als zentrale Customizing- und</TDLINE>
       </item>
       <item>
        <TDFORMAT></TDFORMAT>
        <TDLINE> Validierungs-Engine für das Reparaturdruck-Framework. Sie löst die</TDLINE>
       </item>
       <item>
        <TDFORMAT></TDFORMAT>
        <TDLINE> Definitionen auf und steuert Generierungs-Tasks in Entwicklungssystemen.</TDLINE>
       </item>
       <item>
        <TDFORMAT>U1</TDFORMAT>
        <TDLINE>FUNKTIONEN</TDLINE>
       </item>
       <item>
        <TDFORMAT>AS</TDFORMAT>
        <TDLINE>Diese Klasse bietet folgende wesentliche Operationen:</TDLINE>
       </item>
       <item>
        <TDFORMAT>B1</TDFORMAT>
        <TDLINE>- Auflösung der passenden Druckertreiber über einen In-Memory-Puffer</TDLINE>
       </item>
       <item>
        <TDFORMAT></TDFORMAT>
        <TDLINE>  durch Abgleich der Vertrag-, SKZ- und AKZ-Hierarchien</TDLINE>
       </item>
       <item>
        <TDFORMAT></TDFORMAT>
        <TDLINE>  in /CTDI/REP_FORMS.</TDLINE>
       </item>
       <item>
        <TDFORMAT>B1</TDFORMAT>
        <TDLINE>- Abgesicherte automatische SE24-Klassengenerierung: Prüft die</TDLINE>
       </item>
       <item>
        <TDFORMAT></TDFORMAT>
        <TDLINE>  Mandanten-Änderbarkeit (TR_SYS_PARAMS) und Berechtigung S_DEVELOP,</TDLINE>
       </item>
       <item>
        <TDFORMAT></TDFORMAT>
        <TDLINE>  bevor Klassenstubs im DEV-System generiert werden.</TDLINE>
       </item>
      </LINES>
     </item>
