         <draw h="0.289361in" name="Repair_Images" w="196.85mm">
            <ui>
               <textEdit/>
            </ui>
            <value>
               <text xliff:rid="B5EE418A-0F2B-4415-89B7-1958D4973010">Repair Images</text>
            </value>
            <font baselineShift="0pt" size="18pt" typeface="Arial"/>
            <margin bottomInset="0.5mm" leftInset="0.5mm" rightInset="0.5mm" topInset="0.5mm"/>
            <para hAlign="center" marginLeft="0pt" marginRight="0pt" spaceAbove="0pt" spaceBelow="0pt" textIndent="0pt"/>
            <border>
               <edge/>
               <corner join="round" radius="2mm" thickness="0.176mm"/>
               <fill>
                  <color value="51,204,204"/>
               </fill>
            </border>
            <?renderCache.bounds 555166 18000 0 0 1417 1417 0 0?>
            <?renderCache.textRun 13 Repair Images 0 220474 15629 0 0 0 "Arial" 0 0 18000 ISO-8859-1?></draw>
         <subform layout="tb" name="imgs">
            <bind match="none"/>
            <subform layout="tb" name="DATA_line" w="195mm">
               <subform layout="tb" name="item_linx" w="195mm">
                  <bind match="none"/>
                  <field access="readOnly" minH="5mm" name="FILENAME" w="195mm">
                     <ui>
                        <textEdit>
                           <margin/>
                        </textEdit>
                     </ui>
                     <font typeface="Arial" underline="1"/>
                     <margin bottomInset="0mm" leftInset="1mm" rightInset="0mm" topInset="0mm"/>
                     <para vAlign="middle"/>
                     <bind match="dataRef" ref="$.FILENAME"/>
                     <border>
                        <edge>
                           <color value="51,204,204"/>
                        </edge>
                        <corner thickness="0.176mm">
                           <color value="51,204,204"/>
                        </corner>
                        <fill>
                           <color value="0,255,255"/>
                        </fill>
                     </border>
                     <event activity="ready" name="event__layout_ready" ref="$layout">
                        <script>

xfa.resolveNode("FILENAME").rawValue = Concat($.WIDTH, " x ", $.HEIGHT, " dpi=", $.DPI)
</script>
                     </event>
                  </field>
                  <field minH="33mm" name="IMG" w="195mm">
                     <ui>
                        <imageEdit data="embed"/>
                     </ui>
                     <bind match="dataRef" ref="$.IMG"/>
                     <desc>
                        <exData name="Schema Annotation">Graphic Node GRAPHIC
URL-FIELD = IT_IMAGES-CONTENT</exData>
                        <text name="embeddedHref">Unknown Embedded URI</text>
                     </desc>
                     <border>
                        <edge>
                           <color value="51,204,204"/>
                        </edge>
                        <corner thickness="0.176mm">
                           <color value="51,204,204"/>
                        </corner>
                     </border>
                     <value>
                        <image contentType="application/octet-stream"/>
                     </value>
                     <margin bottomInset="1mm" leftInset="1mm" rightInset="1mm" topInset="1mm"/>
                     <event activity="ready" name="event__layout_ready" ref="$layout">
                        <script>
var imgW = $.WIDTH
var imgH = $.HEIGHT

if (imgW &gt; 0 and imgH &gt; 0) then
  var maxW = 195
  var physW = imgW / 96 * 25.4
  var physH = imgH / 96 * 25.4

  if (physW &gt; maxW) then
    physH = physH * (maxW / physW)
    physW = maxW
  endif

  this.w = Concat(Floor(physW), "mm")
  this.h = Concat(Floor(physH), "mm")
endif
</script>
                     </event>
                  </field>
                  <keep intact="contentArea"/>
                  <?templateDesigner expand 1?></subform>
               <assist role="TR"/>
               <occur max="-1"/>
               <bind match="dataRef" ref="$.IT_IMAGES.DATA[*]"/>
               <border>
                  <edge presence="hidden"/>
                  <corner presence="hidden" thickness="0.176mm"/>
               </border>
               <?templateDesigner rowpattern first:1, next:1, firstcolor:f0f0f0, nextcolor:ffffff, apply:0?>
               <margin bottomInset="0mm" leftInset="0mm" rightInset="0mm" topInset="0mm"/>
               <?templateDesigner expand 1?>
               <keep intact="contentArea"/>
            </subform>
            <?templateDesigner rowpattern first:1, next:1, firstcolor:f0f0f0, nextcolor:ffffff, apply:0?>
            <?templateDesigner expand 1?>
            <margin bottomInset="1mm" leftInset="1mm" rightInset="1mm" topInset="1mm"/>
