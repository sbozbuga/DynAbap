     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>/CTDI/PRINT_REPAIR_MASS</TDNAME>
      <TDID>RE</TDID>
      <TDSPRAS>D</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00001</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;PURPOSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Das Programm /CTDI/PRINT_REPAIR_MASS dient zur Massenverarbeitung und</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> zum Massendruck von Reparaturaufträgen über ein interaktives ALV-Grid.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>HAUPTMERKMALE</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Selektion von Reparaturaufträgen anhand von Auftragsnummer, Auftragsart,</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE> Werk und Erfassungsdatum.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Interaktives ALV-Grid mit Mehrfachauswahl und Statusanzeige.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Massendruck auf Spool oder lokaler Download als PDF-Dateien.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Verwendung des Drucktreiber-Frameworks /CTDI/CL_PRINT_DRIVER_BASE.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>VORGEHENSWEISE</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>1. Selektionsparameter eingeben und Report ausführen.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>2. Gewünschte Reparaturaufträge im ALV-Grid markieren.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>3. Funktion &apos;Markierte drucken&apos; oder &apos;Als PDF speichern&apos; wählen.</TDLINE>
      </TLINE>
     </LINES>
    </item>
    <item>
     <DOKIL>
      <ID>RE</ID>
