    </TLINE>
    <TLINE>
     <TDFORMAT>AS</TDFORMAT>
     <TDLINE>The /CTDI/CL_PRINT_DATA_CTDI class is the data provider extension for</TDLINE>
    </TLINE>
    <TLINE>
     <TDLINE> CTDI repair printouts. It contains database select and mapping logic</TDLINE>
    </TLINE>
    <TLINE>
     <TDLINE> to fetch order details, customer info, and contract parameters.</TDLINE>
    </TLINE>
    <TLINE>
     <TDFORMAT>U1</TDFORMAT>
     <TDLINE>&amp;RELATIONS&amp;</TDLINE>
    </TLINE>
    <TLINE>
     <TDFORMAT>AS</TDFORMAT>
     <TDLINE>This class is instantiated and used by the print driver subclass</TDLINE>
    </TLINE>
    <TLINE>
     <TDLINE> /CTDI/CL_PRINT_DRIVER_CTDI to supply form parameters.</TDLINE>
    </TLINE>
    <TLINE>
     <TDFORMAT>U1</TDFORMAT>
     <TDLINE>&amp;HINTS&amp;</TDLINE>
    </TLINE>
    <TLINE>
     <TDFORMAT>AS</TDFORMAT>
     <TDLINE>All database selections are optimized and buffer-friendly to prevent</TDLINE>
    </TLINE>
    <TLINE>
     <TDLINE> redundant database hits during bulk print processing.</TDLINE>
    </TLINE>
   </LINES>
