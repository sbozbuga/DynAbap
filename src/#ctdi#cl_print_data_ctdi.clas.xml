    </TLINE>
    <TLINE>
     <TDLINE> /CTDI/CL_PRINT_DRIVER_CTDI to supply form parameters.</TDLINE>
    </TLINE>
    <TLINE>
     <TDFORMAT>U1</TDFORMAT>
     <TDLINE>&amp;HINTS&amp;</TDLINE>
    </TLINE>
    <TLINE>
     <TDFORMAT>AS</TDFORMAT>
     <TDLINE>All database selections are optimized and buffer-friendly to prevent</TDLINE>
    </TLINE>
    <TLINE>
     <TDLINE> redundant database hits during bulk print processing.</TDLINE>
    </TLINE>
